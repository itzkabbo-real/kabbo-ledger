rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hardcodedOwner() {
      return signedIn() && (
        request.auth.uid == "Etx7842cBTNxw2D92fUOIGOnMI52" ||
        request.auth.token.email == "aryanshaykat331@gmail.com"
      );
    }

    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function membership(shopId) {
      return get(memberPath(shopId));
    }

    function activeMember(shopId) {
      return hardcodedOwner() || (
        signedIn() &&
        exists(memberPath(shopId)) &&
        membership(shopId).data.active != false &&
        membership(shopId).data.role in ["owner", "manager", "staff", "viewer"]
      );
    }

    function role(shopId) {
      return hardcodedOwner() ? "owner" : membership(shopId).data.role;
    }

    function canWrite(shopId) {
      return activeMember(shopId) && role(shopId) in ["owner", "manager", "staff"];
    }

    function canManage(shopId) {
      return activeMember(shopId) && role(shopId) in ["owner", "manager"];
    }

    function operation(shopId, operationId) {
      return getAfter(
        /databases/$(database)/documents/shops/$(shopId)/entries/$(operationId)
      ).data;
    }

    function newStock(shopId, stockId) {
      return getAfter(
        /databases/$(database)/documents/shops/$(shopId)/stock/$(stockId)
      ).data;
    }

    match /shops/{shopId} {
      allow read: if activeMember(shopId);
      allow write: if false;

      match /members/{uid} {
        allow get: if signedIn() && (uid == request.auth.uid || hardcodedOwner());
        allow list: if hardcodedOwner();
        allow create, update, delete: if hardcodedOwner();
      }

      match /entries/{entryId} {
        allow read: if activeMember(shopId);
        allow create: if canWrite(shopId)
          && request.resource.data.shopId == shopId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.type in ["buy", "sale", "exchange", "expense", "due_collection"];
        allow update, delete: if false;
      }

      match /stock/{stockId} {
        allow read: if activeMember(shopId);
        allow create: if canWrite(shopId)
          && request.resource.data.shopId == shopId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.quantity >= 1
          && request.resource.data.soldQuantity == 0;
        allow update: if canWrite(shopId)
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.quantity == resource.data.quantity
          && request.resource.data.soldQuantity == resource.data.soldQuantity + 1
          && request.resource.data.soldQuantity <= request.resource.data.quantity
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["soldQuantity", "status", "updatedAt", "lastOperationId"])
          && operation(shopId, request.resource.data.lastOperationId).type in ["sale", "exchange"]
          && (
            operation(shopId, request.resource.data.lastOperationId).stockId == stockId ||
            operation(shopId, request.resource.data.lastOperationId).newPhoneStockId == stockId
          )
          && (
            (request.resource.data.soldQuantity == request.resource.data.quantity
              && (
                (operation(shopId, request.resource.data.lastOperationId).type == "sale"
                  && request.resource.data.status == "sold") ||
                (operation(shopId, request.resource.data.lastOperationId).type == "exchange"
                  && request.resource.data.status == "exchanged")
              )) ||
            (request.resource.data.soldQuantity < request.resource.data.quantity
              && request.resource.data.status == "in_stock")
          );
        allow delete: if false;
      }

      match /customers/{customerId} {
        allow read: if activeMember(shopId);
        allow create: if canWrite(shopId)
          && request.resource.data.shopId == shopId
          && request.resource.data.dueBalance > 0
          && operation(shopId, request.resource.data.lastOperationId).type in ["sale", "exchange"]
          && operation(shopId, request.resource.data.lastOperationId).customerId == customerId
          && request.resource.data.dueBalance
            == operation(shopId, request.resource.data.lastOperationId).dueAmount;
        allow update: if canWrite(shopId)
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.dueBalance >= 0
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "name", "phone", "address", "dueBalance", "totalDueCreated",
                "updatedAt", "lastOperationId"
              ])
              && operation(shopId, request.resource.data.lastOperationId).type in ["sale", "exchange"]
              && operation(shopId, request.resource.data.lastOperationId).customerId == customerId
              && request.resource.data.dueBalance == resource.data.dueBalance
                + operation(shopId, request.resource.data.lastOperationId).dueAmount
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "dueBalance", "totalCollected", "updatedAt", "lastOperationId"
              ])
              && operation(shopId, request.resource.data.lastOperationId).type == "due_collection"
              && operation(shopId, request.resource.data.lastOperationId).customerId == customerId
              && request.resource.data.dueBalance == resource.data.dueBalance
                - operation(shopId, request.resource.data.lastOperationId).amount
            )
          );
        allow delete: if false;
      }

      match /imeiIndex/{imei} {
        allow read: if activeMember(shopId);
        allow create: if canWrite(shopId)
          && request.resource.data.shopId == shopId
          && request.resource.data.active == true
          && newStock(shopId, request.resource.data.stockId).imeiSerial == imei;
        allow update: if canWrite(shopId) && (
          (
            request.resource.data.shopId == resource.data.shopId
            && request.resource.data.stockId == resource.data.stockId
            && request.resource.data.active == false
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["active", "soldEntryId", "updatedAt"])
          ) ||
          (
            resource.data.active == false
            && request.resource.data.active == true
            && request.resource.data.shopId == shopId
            && request.resource.data.createdBy == request.auth.uid
            && newStock(shopId, request.resource.data.stockId).imeiSerial == imei
          )
        );
        allow delete: if false;
      }
    }
  }
}
