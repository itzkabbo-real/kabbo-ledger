# Copy to .env for local dev, and set the same VITE_* keys in Netlify
# Site settings -> Environment variables. Never commit the real .env file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Logical shop id, must match a document under shops/{VITE_SHOP_ID} in Firestore
VITE_SHOP_ID=kabbo_mobile_kushtia

# Owner fallback (server-side rules + client bootstrap use this so the owner
# is never demoted to Staff even before a members/{uid} doc exists)
VITE_OWNER_UID=
VITE_OWNER_EMAIL=

# Netlify function secrets (server-side only, never prefixed with VITE_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FIREBASE_SERVICE_ACCOUNT=
REPORT_TEST_SECRET=
LOW_STOCK_THRESHOLD=2
